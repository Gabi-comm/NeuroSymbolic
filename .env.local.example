# Copy to .env.local. Next.js only exposes NEXT_PUBLIC_* to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the FastAPI backend, used by the /api/analyze route handler.
API_BASE_URL=http://127.0.0.1:8000

# Web Push: phone alerts to admins for new reports (migration.sql section K).
# Generate a pair once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:oasysph@gmail.com
# Shared with Supabase (private.push_config.secret); any long random string.
PUSH_WEBHOOK_SECRET=your-long-random-secret
