# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must never be committed.

# Google Gemini — used by the current bulletin generator.
# Replaced by a local Ollama model in Phase 2 (decision D2), after which this is optional.
GEMINI_API_KEY=your-key-here

# Local LLM (Phase 2)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Ground Sample Distance in mm/pixel. Default matches the paper, section 3.3.C.
DEFAULT_GSD_MM_PX=4.357
