{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL" }]
    },
    "backend": {
      "root": "backend/",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "app" } }]
}
